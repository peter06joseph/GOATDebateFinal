<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NBA Player Picker</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <span class="nav-logo">🏀 NBA Player Picker</span>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/players">Search</a>
            <a href="/history">History</a>
        </div>
    </nav>

    <main class="hero">
        <div class="hero-content">
            <h1 class="hero-title">NBA Player Picker</h1>
            <p class="hero-sub">Choose between LeBron James and Michael Jordan — and we’ll tell you the truth.</p>
            <a href="/players" class="btn-primary">Choose the GOAT</a>
            <a href="/history" class="btn-secondary">View History</a>
        </div>
        <div class="hero-ball">🏀</div>
    </main>

    <section class="features">
        <div class="feature-card">
            <div class="feature-icon">🐐</div>
            <h3>The GOAT Debate</h3>
            <p>Pick between LeBron James and Michael Jordan.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">⚖️</div>
            <h3>Instant Verdict</h3>
            <p>Choose wisely. If you're wrong, we’ll tell you.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">📁</div>
            <h3>History</h3>
            <p>See how many times each GOAT was chosen.</p>
        </div>
    </section>
</body>
</html>
